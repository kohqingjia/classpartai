# Copy to .env and fill in. Never commit .env.

# API key for the LLM provider the project uses (rename to match, e.g. OPENAI_API_KEY).
LLM_API_KEY=""

# Hugging Face access token for the pyannote speaker-diarisation models (Listener agent).
# Create one at https://huggingface.co/settings/tokens and accept the model's terms on its page.
HF_TOKEN=""

# Random seed shared by all experiments. Change only to test seed sensitivity.
SEED=42
