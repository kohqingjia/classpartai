# Copy to .env and fill in. Never commit .env.

# Model for the agents. Any OpenAI-compatible endpoint works: leave OPENAI_BASE_URL unset for
# OpenAI, or point it at a local server (e.g. http://localhost:11434/v1 for Ollama).
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-5-mini"
# OPENAI_BASE_URL=""

# Hugging Face access token for the pyannote speaker-diarisation models (Listener agent).
# Create one at https://huggingface.co/settings/tokens and accept the model's terms on its page.
HF_TOKEN=""

# AgentMail, used to send approved feedback. The key needs
# "Send & read mail" access; a send-only key is rejected with "Sender address rejected".
AGENTMAIL_API_KEY=""
AGENTMAIL_INBOX="classpartai@agentmail.to"

# Test mode (default on) sends every email to EMAIL_TEST_RECIPIENT instead of the student.
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=""

# Research agent's models: "openai" (uses the key above) or "ollama" (free, on your own computer).
LLM_PROVIDER="openai"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"   # change it, and rebuild the index

# Ollama (LLM_PROVIDER="ollama"): install it from ollama.com, keep the app running, then
#   ollama pull qwen3:8b && ollama pull nomic-embed-text
# In the Ollama app's settings, raise the context length to 32k: the agent's prompts get long.
# Results from a small local model are fine for trying things out, not for the evaluation.
# OLLAMA_MODEL="qwen3:8b"                 # must support tool calling; qwen3:4b if memory is tight
# OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# LLM_REASONING_EFFORT="none"            # turn qwen3's thinking off: much faster, a little worse

# Tavily web search for the Research agent (optional: without it, Research has no web source).
TAVILY_API_KEY=""

# Research agent: the course's schedule and labelled contributions, the lecture files (git-ignored),
# and where their embeddings are saved.
# COURSE_DIR="data/is469"
# MATERIALS_DIR="data/raw/is469"
# INDEX_DIR="data/index"
# Research budgets per contribution.
# RESEARCH_MAX_STEPS=12
# RESEARCH_MAX_COURSE_SEARCHES=6
# RESEARCH_MAX_WEB_SEARCHES=3
# RESEARCH_MAX_GRADES=8

# Which agent the coordinator's retrieve_evidence uses: "research" (the Research agent above, on
# the session's own documents, no web; the default) or "course" (evidence.py). Lighter budgets in a
# session:
# EVIDENCE_AGENT="research"
# RESEARCH_BRIDGE_MAX_STEPS=8
# RESEARCH_BRIDGE_MAX_COURSE_SEARCHES=4
# RESEARCH_BRIDGE_MAX_GRADES=5
# Documents for sessions made from new recordings (default: the demo notes). For the IS469 files:
#   uv run python -m classpartai.research export-documents, then:
# COURSE_DOCUMENTS="var/is469_documents.json"

# Random seed shared by all experiments. Change only to test seed sensitivity.
SEED=42
