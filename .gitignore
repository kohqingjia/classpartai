# Node dependencies
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Notebooks
.ipynb_checkpoints/

# Environment and secrets
.env
.env.local

# Large or licensed data (document sources in data/README.md)
data/raw/
# Built by `python -m classpartai.research ingest`; rebuild rather than commit
data/index/

# Local
.DS_Store
scratch
.claude
.worktrees/

# Nested virtualenvs (e.g. audio-service/.venv)
**/.venv/

# Local audio recordings, voice enrolments and downloaded speech models (never commit: personal
# voice data, and model files are fetched at run time)
audio-service/enrollments/
audio-service/models/
*.m4a
*.wav
*.mp3
# Except the team's demo seminars and voice samples, committed with the speakers' agreement
!data/demo-seminars/*.wav
!data/voice-samples/*.wav

# App data (class list, emails, audit log) when run locally
var/

# Browser automation output
.playwright-mcp/

# Blank review sheets from eval/system_eval.py; the Evaluation page is where they are filled in
eval/results/qualitative-*.md
